# Copy to `.env.local` and adjust per environment.
# Same backend as the staff dashboard (Hadidi-win-back) — only the
# /api/distributor/* routes are used here.

NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Reverb (websocket) — same values as Hadidi-win-front's, since both apps
